<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- The LLM key is encrypted with a Keystore key that does not transfer to another device. -->
        <exclude domain="file" path="datastore/llm_settings.preferences_pb" />
        <!-- Data packs (reference databases) are re-downloaded on demand. -->
        <exclude domain="file" path="packs/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/llm_settings.preferences_pb" />
        <exclude domain="file" path="packs/" />
    </device-transfer>
</data-extraction-rules>
