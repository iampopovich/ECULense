<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- The LLM key is encrypted with a Keystore key that does not transfer to another device. -->
    <exclude domain="file" path="datastore/llm_settings.preferences_pb" />
    <!-- R-F: the MQTT broker password is encrypted with a Keystore key that does not transfer either. -->
    <exclude domain="file" path="datastore/mqtt.preferences_pb" />
    <!-- Data packs (reference databases, tens of MB) are re-downloaded on demand. -->
    <exclude domain="file" path="packs/" />
</full-backup-content>
