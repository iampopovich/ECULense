<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext http is needed for LLM servers on the home network (Ollama, LM Studio, vLLM), in both builds.
     IP ranges cannot be set here, so the restriction lives in code: :core:ai EndpointUrl/LocalNetwork allow http://
     only to loopback, 10/8, 172.16/12, 192.168/16, link-local and *.local; public addresses are https only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
