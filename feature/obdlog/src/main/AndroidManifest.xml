<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Own FileProvider subclass: one provider class per authority, no clash with other features. -->
        <provider
            android:name="io.github.iampopovich.eculense.feature.obdlog.ObdLogFileProvider"
            android:authorities="${applicationId}.obdlog.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/obdlog_file_paths" />
        </provider>
    </application>
</manifest>
